# Replace HOST and PORT for your Confluent Cloud cluster, e.g. --> bootstrap.servers="pgc-ep67a.us-east-2.aws.confluent.cloud:9092"
bootstrap.servers="HOST:PORT"

# Replace USERNAME and PASSWORD, e.g. --> sasl.jaas.config="org.apache.kafka.common.security.plain.PlainLoginModule required username=\"{{ CLUSTER_API_KEY }}\" password=\"{{ CLUSTER_API_SECRET }}\";"
sasl.jaas.config="org.apache.kafka.common.security.plain.PlainLoginModule required username=\"USERNAME\" password=\"PASSWORD\";"
