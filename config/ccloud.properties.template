# Connection settings for Confluent Cloud.
#   cp config/ccloud.properties.template config/ccloud.properties
# then fill in the placeholders. config/ccloud.properties is gitignored: never commit real keys.

# ---- Kafka cluster ---- #
bootstrap.servers={{ BROKER_ENDPOINT }}
security.protocol=SASL_SSL
sasl.mechanism=PLAIN
sasl.jaas.config=org.apache.kafka.common.security.plain.PlainLoginModule required username='{{ CLUSTER_API_KEY }}' password='{{ CLUSTER_API_SECRET }}';

# ---- Schema Registry (only the dead letter queue demo uses it) ---- #
schema.registry.url={{ SR_ENDPOINT }}
basic.auth.credentials.source=USER_INFO
basic.auth.user.info={{ SR_API_KEY }}:{{ SR_API_SECRET }}
